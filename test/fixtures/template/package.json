{
  "name": "averoajs",
  "version": "2.1.0",
  "description": "'laravel like' boiler plate for express",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/*.test.js",
    "link:local": "node scripts/link-local.mjs",
    "migrate:up": "knex migrate:latest",
    "seed:run": "knex seed:run"
  },
  "author": {
    "name": "Budi Hermawan"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/budiherma1/averoajs.git"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mysql2": "^3.15.0"
  },
  "devDependencies": {
    "better-sqlite3": "^12.4.1",
    "nodemon": "^3.1.10"
  }
}
